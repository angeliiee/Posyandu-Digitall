# ==========================================
# KONFIGURASI SUPABASE DATABASE (POSTGRESQL)
# ==========================================
# Dapatkan Project URL dan Anon / Public Key dari:
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-publishable-key

# JANGAN PERNAH memasukkan service_role key di sini untuk keamanan aplikasi.
# Konfigurasi ini juga dapat diletakkan di posyandu_digital_v2/.streamlit/secrets.toml jika menggunakan Streamlit Cloud.
